APP_NAME=ShefaGuide AI
APP_VERSION=0.1.0
PHASE=walking-skeleton
API_V1_PREFIX=/api/v1
RATE_LIMIT=15/minute
RATE_LIMIT_REQUESTS=15
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","*"]
# Primary LLM Provider (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Secondary LLM Fallback Provider (SovereignEG OpenAI-Compatible API)
SOVEREIGNEG_API_KEY=your_sovereigneg_api_key_here
SOVEREIGNEG_BASE_URL=https://backend.sovereigneg.com/v1
SOVEREIGNEG_MODEL=gemini-2.5-flash
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=shefaguide_medical_chunks
DATABASE_URL=postgresql+asyncpg://shefaguide:shefaguide_secret@localhost:5432/shefaguide_audit
GROQ_API_KEY=your_groq_api_key_here
GROQ_STT_MODEL=whisper-large-v3
GROQ_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
VOICE_TIMEOUT_SECONDS=2.5
TTS_PROVIDER=edge-or-browser-fallback
